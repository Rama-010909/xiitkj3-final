rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /accounts/{document=**} { allow read, write: if true; }
    match /users/{document=**} { allow read, write: if true; }
    match /absensi/{document=**} { allow read, write: if true; }
    match /absensi_pelajaran/{document=**} { allow read, write: if true; }
    match /kehadiran_pelajaran/{document=**} { allow read, write: if true; }
    match /jadwal/{document=**} { allow read, write: if true; }
    match /siswa/{document=**} { allow read, write: if true; }
    match /struktur/{document=**} { allow read, write: if true; }
    match /pengaturan/{document=**} { allow read, write: if true; }
    match /tugas/{document=**} { allow read, write: if true; }
    match /pengumpulan_tugas/{document=**} { allow read, write: if true; }
  }
}